{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Temporary direct Edge Delta ECS onboarding verification",
  "Parameters": {
    "RunID": {
      "Type": "String"
    },
    "VpcID": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "AgentKey": {
      "Type": "String",
      "NoEcho": true
    },
    "AgentImage": {
      "Type": "String"
    },
    "APIEndpoint": {
      "Type": "String"
    },
    "AIEndpoint": {
      "Type": "String"
    }
  },
  "Resources": {
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {
          "Ref": "RunID"
        }
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Outbound-only onboarding test",
        "VpcId": {
          "Ref": "VpcID"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "AgentSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Ref": "RunID"
        },
        "SecretString": {
          "Ref": "AgentKey"
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ReadAgentCredential",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "AgentSecret"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Ref": "RunID"
        },
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ContainerDefinitions": [
          {
            "Name": "edgedelta",
            "Image": {
              "Ref": "AgentImage"
            },
            "Essential": true,
            "MemoryReservation": 512,
            "Secrets": [
              {
                "Name": "ED_API_KEY",
                "ValueFrom": {
                  "Ref": "AgentSecret"
                }
              }
            ],
            "Environment": [
              {
                "Name": "ED_API_ENDPOINT",
                "Value": {
                  "Ref": "APIEndpoint"
                }
              },
              {
                "Name": "ED_AI_EVENT_ENDPOINT",
                "Value": {
                  "Ref": "AIEndpoint"
                }
              }
            ]
          },
          {
            "Name": "application",
            "Image": "public.ecr.aws/docker/library/python@sha256:4c47124a8391cb7a9f571164147d154777cf012a4ece5f86097130d7a4478111",
            "Essential": true,
            "MemoryReservation": 128,
            "EntryPoint": [
              "python3",
              "-u",
              "-c"
            ],
            "Command": [
              "__EMITTER_CODE__"
            ],
            "Environment": [
              {
                "Name": "ONBOARD_RUN_ID",
                "Value": {
                  "Ref": "RunID"
                }
              },
              {
                "Name": "ONBOARD_DURATION_SECONDS",
                "Value": "900"
              },
              {
                "Name": "OTEL_EXPORTER_OTLP_ENDPOINT",
                "Value": "http://127.0.0.1:4318"
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "SecurityGroup": {
      "Value": {
        "Ref": "SecurityGroup"
      }
    },
    "TaskDefinition": {
      "Value": {
        "Ref": "Task"
      }
    }
  }
}
