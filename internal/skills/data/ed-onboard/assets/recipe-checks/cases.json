      "id": "cpu-average",
      "recipe": "metrics",
      "input": {
        "_type": "log",
        "body": "{\"metric_stream_name\": \"example\", \"account_id\": \"111122223333\", \"region\": \"us-west-2\", \"namespace\": \"AWS/RDS\", \"metric_name\": \"CPUUtilization\", \"dimensions\": {\"DBInstanceIdentifier\": \"example-rds\"}, \"timestamp\": 1700000000000, \"value\": {\"sum\": 15, \"count\": 3}, \"unit\": \"None\"}",
        "attributes": {},
        "resource": {},
        "timestamp": 1700000060000
      },
      "expected": [
        {
          "_type": "metric",
          "name": "aws.rds.cpu_utilization",
          "gauge": {
            "value": 5
          },
          "unit": "1",
          "timestamp": 1700000000000,
          "resource": {
            "aws.rds.db_instance_identifier": "example-rds",
            "service.name": "example-rds-rds-engine"
          }
        }
      ]
    },
