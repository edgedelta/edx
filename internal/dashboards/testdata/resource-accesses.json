{
  "k8s-overview": [
    {
      "domain": "metric",
      "query": "count_unique(k8s.node.name):k8s.ksm.node.info.value{ed.tag:$cluster }.rollup(300)"
    },
    {
      "domain": "metric",
      "query": "count_unique(k8s.namespace.name):k8s.ksm.namespace.status_phase.value{ed.tag:$cluster}.rollup(300)"
    },
    {
      "domain": "metric",
      "query": "count_unique(k8s.pod.name):k8s.ksm.pod.status_phase.value{ed.tag:$cluster AND k8s.namespace.name:$namespace AND @phase: \"Running\"}.rollup(300)"
    },
    {
      "domain": "metric",
      "query": "count_unique(k8s.container.name,k8s.pod.name):k8s.ksm.pod.container_status_running.value{ed.tag:$cluster AND k8s.namespace.name:$namespace}.rollup(300)"
    },
    {
      "domain": "event",
      "query": "{(ed.tag:$cluster AND k8s.namespace.name:$namespace) AND (event.domain:\"K8s\")} by {severity_text}"
    },
    {
      "domain": "pattern",
      "query": "{ed.tag:$cluster AND k8s.namespace.name:$namespace}"
    },
    {
      "domain": "event",
      "query": "count_unique():{(ed.tag:$cluster AND k8s.namespace.name:$namespace) AND (event.domain:\"K8s\")} by {severity_text,event.type}"
    },
    {
      "domain": "event",
      "query": "count_unique():{(ed.tag:$cluster AND k8s.namespace.name:$namespace) AND (event.domain:\"K8s\")} by {event.type}"
    },
    {
      "domain": "event",
      "query": "count_unique():{(ed.tag:$cluster AND k8s.namespace.name:$namespace) AND (event.domain:\"K8s\")} by {severity_text}"
    },
    {
      "domain": "pattern",
      "query": "{ed.tag:$cluster AND k8s.namespace.name:$namespace}"
    },
    {
      "domain": "metric",
      "query": "count_unique(k8s.deployment.name):k8s.ksm.deployment_metadata_generation.value{ed.tag:$cluster AND k8s.namespace.name:$namespace}.rollup(300)"
    },
    {
      "domain": "metric",
      "query": "count_unique(k8s.daemonset.name):k8s.ksm.daemonset_metadata_generation.value{ed.tag:$cluster AND k8s.namespace.name:$namespace}.rollup(300)"
    },
    {
      "domain": "metric",
      "query": "count_unique(k8s.statefulset.name):k8s.ksm.statefulset_metadata_generation.value{ed.tag:$cluster AND k8s.namespace.name:$namespace}.rollup(300)"
    },
    {
      "domain": "metric",
      "query": "count_unique(k8s.cronjob.name):k8s.ksm.cronjob_info.value{ed.tag:$cluster AND k8s.namespace.name:$namespace}.rollup(300)"
    },
    {
      "domain": "facet_option",
      "query": "",
      "scope": "metric",
      "facet_path": "ed.tag"
    },
    {
      "domain": "facet_option",
      "query": "ed.tag:$cluster",
      "scope": "metric",
      "facet_path": "k8s.namespace.name"
    }
  ],
  "top-talkers": [
    {
      "domain": "metric",
      "query": "sum:ed.pipeline.node.read_bytes{*} by {ed.tag}.rollup(60)"
