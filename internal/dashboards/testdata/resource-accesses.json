  "observability-posture": [
    {
      "domain": "event",
      "query": "{(severity_text:ALERT event.type:metric_threshold) AND (event.domain:(\"Monitor\" OR \"Monitor Alerts\"))}"
    },
    {
      "domain": "log",
      "query": "{error AND ed.tag: $fleet} by {host.name}"
